        <label class="field-label">Choose from the results
          <select id="writingWordSelect" aria-describedby="writingWordPosition writingSearchStatus"></select>
        </label>
      </div>
      <div class="table-status" id="writingSearchStatus" role="status">Showing nearby words. Search to filter all 600.</div>
      <div class="sr-only" id="writingLiveStatus" role="status" aria-live="polite"></div>

      <div class="writing-layout">
        <article class="writing-context-card" aria-labelledby="writingWordHanzi">
          <div class="writing-word-meta">
            <span id="writingWordPosition">Word 1 of 600</span>
            <span id="writingPracticeCount">Not practised yet</span>
          </div>
          <div class="writing-word-hanzi" id="writingWordHanzi" lang="zh-Hans">阿姨</div>
          <div class="writing-word-pinyin" id="writingWordPinyin" lang="zh-Latn">āyí</div>
          <div class="writing-word-meaning" id="writingWordMeaning">aunt</div>
          <button class="speak-button" id="writingSpeakWord" type="button"><span aria-hidden="true">◖)))</span> Hear word</button>

          <div class="example-block">
            <p class="example-label">SHORT EXAMPLE</p>
            <div class="example-hanzi" id="writingExampleHanzi" lang="zh-Hans"></div>
            <div class="example-pinyin" id="writingExamplePinyin" lang="zh-Latn"></div>
            <div class="example-english" id="writingExampleEnglish"></div>
            <button class="speak-button" id="writingSpeakSentence" type="button"><span aria-hidden="true">◖)))</span> Hear sentence</button>
          </div>
        </article>

        <article class="writing-pad-card">
          <div class="writing-pad-context" aria-hidden="true">
            <strong id="writingCompactHanzi" lang="zh-Hans">阿姨</strong>
            <span id="writingCompactPinyin" lang="zh-Latn">āyí</span>
            <span id="writingCompactMeaning">aunt</span>
          </div>
          <div class="writing-pad-heading">
            <div>
              <p class="eyebrow">CURRENT CHARACTER</p>
              <h2 id="writingCharacterLabel">阿</h2>
            </div>
            <span class="writing-instruction">Follow the centre grid</span>
          </div>

          <div class="character-picker" id="writingCharacterButtons" aria-label="Characters in this word"></div>

          <div class="writing-stage" id="writingStage">
            <div class="writing-guide" id="writingGuideCharacter" lang="zh-Hans" aria-hidden="true">阿</div>
            <canvas id="writingCanvas" aria-label="Handwriting area for the selected Chinese character">Use the character model and the written stroke guidance with a teacher if canvas drawing is not accessible.</canvas>
          </div>

          <div class="writing-tools">
            <button class="button ghost" type="button" id="writingUndoButton">Undo stroke</button>
            <button class="button ghost" type="button" id="writingClearButton">Clear</button>
            <button class="button ghost" type="button" id="writingGuideButton" aria-pressed="true">Hide guide</button>
            <button class="button ghost" type="button" id="writingPaperButton" aria-pressed="false">Practised on paper</button>
          </div>

          <details class="stroke-order-help">
            <summary>Basic stroke-order guidance</summary>
            <ol>
              <li>Usually write from top to bottom and left to right.</li>
              <li>When strokes cross, horizontal commonly comes before vertical.</li>
              <li>Write the outside before the inside, then close a frame last.</li>
            </ol>
            <p>Some characters are exceptions. Use a trusted stroke-order model or teacher when a character is new.</p>
          </details>

          <div class="writing-complete-row">
            <button class="button secondary" type="button" id="writingPreviousButton">Previous word</button>
            <button class="button primary" type="button" id="writingCompleteButton" disabled>Write every character first</button>
            <button class="button secondary" type="button" id="writingNextButton">Next word</button>
          </div>
          <p class="writing-note">The guide helps with shape and proportion. The basic rules above are not a character-specific stroke animation, and the app does not judge handwriting accuracy.</p>
        </article>
      </div>
    </section>

    <section class="view" id="view-vocabulary" data-view="vocabulary" aria-labelledby="vocabularyTitle">
      <div class="section-heading align-end">
