  <main id="main" class="main-shell" tabindex="-1">
    <section class="view active" id="view-dashboard" data-view="dashboard" aria-labelledby="dashboardTitle">
      <div class="hero-grid">
        <div>
          <p class="eyebrow" id="todayLabel">YOUR STUDY DAY</p>
